PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
# auto = first key found: ANTHROPIC_API_KEY -> GEMINI_API_KEY -> GROQ_API_KEY, echo stub if none.
# Explicit values: echo | anthropic | gemini | groq
DIALOGUE_PROVIDER=auto
# Free tier, no card: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults: gemini-3.8-flash, openai/gpt-oss-120b, claude-opus-5-5)
# LLM_MODEL=
# REPORTS_DIR=data/reports
# SESSION_IDLE_MINUTES=120
# RATE_LIMIT_PER_MINUTE=40
# Origins allowed to call the API from another domain (comma-separated, * = wildcard).
# CORS_ORIGINS=https://english-office*.vercel.app
# Optional single-service mode: serve the built client from this directory (relative to server/).
# STATIC_DIR=../client/dist
